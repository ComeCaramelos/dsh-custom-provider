{
  "name": "@comecaramelos/dsh-custom-provider",
  "version": "0.0.1",
  "description": "DSH plugin: a \"No API key required\" toggle on saved hand-declared provider cards that writes Authorization: Bearer none so keyless local/self-hosted endpoints stop aborting with \"No API key for provider\"",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "providers",
    "llm",
    "pi-ai"
  ],
  "author": "Robe ComeCaramelos <hello@comecaramelos.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ComeCaramelos/dsh-custom-provider.git"
  },
  "bugs": {
    "url": "https://github.com/ComeCaramelos/dsh-custom-provider/issues"
  },
  "homepage": "https://github.com/ComeCaramelos/dsh-custom-provider#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.client.json",
    "build:host": "tsc",
    "build:client": "tsc -p tsconfig.client.json",
    "clean": "rm -rf lib",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "test": "npm run build && node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^1.0.0",
    "@deepseek-ai/dsh-client-ui-settings": "^1.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
